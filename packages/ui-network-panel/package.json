{
  "name": "@deepseek-ai/dsh-client-ui-network-panel",
  "description": "Right network panel: interface status, ping, rotating globe, and dual up/down traffic sparkline",
  "version": "0.1.0-rc.5",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/deepseek-ai/deepseek-harness.git", "directory": "packages/ui-network-panel" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": { "client": { "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-api-remotes"], "platform": "web" } },
  "files": ["lib/index.js", "lib/client.js", "lib/types/**/*.d.ts"],
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": "workspace:^",
    "@deepseek-ai/dsh-client-runtime": "workspace:^",
    "@deepseek-ai/dsh-client-ui-layout": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-host-system-metrics": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "react": "^18.2.0", "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-api-remotes": "workspace:^",
    "@deepseek-ai/dsh-client-runtime": "workspace:^",
    "@deepseek-ai/dsh-client-ui-layout": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-host-system-metrics": "workspace:^",
    "@types/react": "~18.3.1", "@types/react-dom": "~18.3.0",
    "react": "^18.2.0", "react-dom": "^18.2.0"
  },
  "license": "MIT"
}
