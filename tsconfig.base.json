{
  // Minimal build-time base for this standalone plugin checkout. Mirrors the
  // harness's tsconfig.base.json compiler shape (the package tsconfigs extend
  // through tsconfig.base.client.json) but carries no harness tree paths:
  // tsc project references to in-box harness packages are deliberately absent
  // here — this checkout builds the client bundle with tsdown, which ignores
  // references and resolves cross-package imports from node_modules.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": []
  }
}
